# ---------------------------------------------------------------------------
# Docker image — built from pre-compiled Linux binaries (x86_64 + aarch64),
# as produced by the `build-binaries` job of the Publish workflow.  No Rust
# toolchain, no C compiler, no QEMU Rust cross-compile — just a static copy.
#
# Expects the binaries at dist/<arch>/mediaflow-proxy-light, with <arch> being
# Docker's TARGETARCH (amd64, arm64).
#
# For a local from-source build instead see `Dockerfile` in this repo.
# ---------------------------------------------------------------------------

# ── Runtime stage ──────────────────────────────────────────────────────────
# distroless/cc-debian12 provides glibc + libgcc (required by our Rust
# binary).  No shell, no package manager — ~20 MB total.
FROM gcr.io/distroless/cc-debian12

WORKDIR /app

ARG TARGETARCH
COPY --chmod=755 dist/${TARGETARCH}/mediaflow-proxy-light /app/
COPY config-example.toml /app/config.toml

ENV RUST_LOG=info
ENV CONFIG_PATH=/app/config.toml

EXPOSE 8888

ENTRYPOINT ["/app/mediaflow-proxy-light"]
